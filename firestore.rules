rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 로그인한 본인만 자기 데이터(users/본인ID/...)를 읽고 쓸 수 있어요.
    // 아래 이메일을 config.js의 allowedEmail과 똑같이 맞춰 주세요.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && request.auth.token.email == "nagyeong55555@gmail.com";
    }
  }
}
